DATABASE_URL="postgresql://postgres:postgres@localhost:5432/subscription_tracker"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GMAIL_OAUTH_REDIRECT_URI="http://localhost:3000/api/gmail/callback"
# Authorized redirect URIs on the Google Cloud OAuth client:
#   {AUTH_URL}/api/auth/callback/google   (sign-in: passkey, PIN, 2FA, password)
#   {AUTH_URL}/api/gmail/callback         (read-only inbox connect)

# 32-byte key, hex-encoded (64 chars). Used to encrypt Gmail refresh tokens at rest.
TOKEN_ENCRYPTION_KEY=""

LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

CONFIDENCE_AUTO_APPLY_THRESHOLD="0.85"
VENDOR_FUZZY_MATCH_THRESHOLD="0.88"
EMAIL_SNAPSHOT_TTL_DAYS="30"
INACTIVITY_GRACE_CYCLES="2"
AUDIT_LOG_RETENTION_DAYS="180"
RENEWAL_REMINDER_DAYS="7"
GMAIL_LOOKBACK_MONTHS="12"
GMAIL_MAX_LOOKBACK_MESSAGES="500"
GMAIL_MAX_RETRIES="5"
GMAIL_SYNC_CONCURRENCY="10"

# scripts/backup-db.sh / scripts/restore-db.sh only -- not read by the app itself.
# See docs/backup-and-disaster-recovery.md.
BACKUP_S3_BUCKET=""
BACKUP_S3_ENDPOINT_URL=""
BACKUP_S3_PREFIX="subscription-tracker"
BACKUP_DIR="./backups"
BACKUP_LOCAL_RETENTION_DAYS="3"

# Error tracking (Sentry). Sign up at https://sentry.io, create a Next.js project, and
# copy its DSN below. Leave blank to run with Sentry disabled (e.g. local dev).
NEXT_PUBLIC_SENTRY_DSN=""
# Org/project slugs + an auth token (Settings > Auth Tokens, scope: project:releases) are
# only needed to upload source maps on build, so error stack traces show real source
# instead of minified code. Optional locally; set in CI/production once you have a project.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
